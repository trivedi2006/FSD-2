const EventEmitter = require("events");
const ee = new EventEmitter();

const fs = require("fs");
const http = require("http");

// Event 1: Create File
ee.on("CreateFile", () => {
    fs.writeFile("abc.txt", "this is the initial content of the file", (err) => {
        if (err) {
            console.error("Error occurred while creating file:", err);
        }
        ee.emit("AppendFile");
    });
});

// Event 2: Append File
ee.on("AppendFile", () => {
    fs.appendFile("abc.txt", "\n this is appended content of file", (err) => {
        if (err) {
            console.error("Error occurred while appending to file:", err);
        }
        ee.emit("ReadFile");
    });
});

// Event 3: Read File & Create Server
ee.on("ReadFile", () => {
    const data = fs.readFileSync("abc.txt", "utf-8");

    const server = http.createServer((req, res) => {
        res.writeHead(200, { "Content-Type": "text/html" });
        res.end(data);
    });

    server.listen(3000, () => {
        console.log("Server is running on port 3000");
    });
});

// Start execution
ee.emit("CreateFile");