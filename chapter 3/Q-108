http = require("http")
fs = require("fs")
const server = http.createServer((req,res)=>
{
    data = fs.readFileSync("simple.html","utf-8")
    res.writeHead(200,{"Content-Type":"text/html"})
    res.end(data)
})
server.listen(3003,()=>
{
    console.log("Server is running on port :,http://localhost:3003")
})